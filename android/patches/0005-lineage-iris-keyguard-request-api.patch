+        mIrisAuthenticationCancelSignal = cancelSignal;
+        irisManager.authenticateForKeyguard(userId, cancelSignal,
+                new IrisManager.AuthenticationCallback() {
+                    @Override
+                    public void onAuthenticationSucceeded(int authenticatedUserId) {
+                        if (mIrisAuthenticationCancelSignal != cancelSignal) return;
+                        mIrisAuthenticationCancelSignal = null;
+                        if (authenticatedUserId != userId) {
+                            cancelSignal.cancel();
+                            return;
+                        }
+                        onIrisAuthenticated(authenticatedUserId);
+                    }
