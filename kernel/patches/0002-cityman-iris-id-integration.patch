Subject: [PATCH] media: add dormant cityman iris-ID platform binding
Base-commit: cc84cab9900ee4e7a3046b3756858e9832caee72

Copy kernel/driver/cityman_iris_id.c from LumiaFaceID into the kernel sensor
directory before building. This integration patch does not copy the driver.
The driver is opt-in at build time and inactive until an explicit root write.
No boost supply, GPIO106, flash or CSI stream is declared.

diff --git a/arch/arm64/boot/dts/mmo/common/camera-cityman.dtsi b/arch/arm64/boot/dts/mmo/common/camera-cityman.dtsi
index 7c18a3af..1bce77f0 100644
--- a/arch/arm64/boot/dts/mmo/common/camera-cityman.dtsi
+++ b/arch/arm64/boot/dts/mmo/common/camera-cityman.dtsi
@@ -56,6 +56,24 @@
  */
 
 &cci {
+	/* A separate opt-in ID path, not an Android camera slot. No flash source,
+	 * boost regulator, GPIO106, stream programming or CSI route is declared. */
+	cityman-iris-id {
+		compatible = "microsoft,cityman-iris-id";
+		vana-supply = <&pm8994_l17>;
+		vio-supply = <&pm8994_lvs1>;
+		core-supply = <&pm8994_s3>;
+		vdig-supply = <&pm8994_l3>;
+		reset-gpios = <&msm_gpio 102 0>;
+		clocks = <&clock_mmss clk_mclk1_clk_src>,
+			 <&clock_mmss clk_camss_mclk1_clk>;
+		clock-names = "cam_src_clk", "cam_clk";
+		/* No default state: binding this node must not configure its pins. */
+		pinctrl-names = "iris_active", "iris_sleep";
+		pinctrl-0 = <&cam_sensor_mclk1_active &cityman_iris_reset_active>;
+		pinctrl-1 = <&cam_sensor_mclk1_suspend &cityman_iris_reset_sleep>;
+	};
+
 	/*
 	 * Hill through msm_flash.c (subdev group 16), the only flash the
 	 * camera daemon can see.  The daemon takes the address, power
@@ -273,3 +291,26 @@
 &csid0 {
 	qcom,csi-lane-assign = <0x0423>;
 };
+
+&msm_gpio {
+	cityman_iris_reset_active_grp {
+		qcom,pins = <&gp 102>;
+		qcom,num-grp-pins = <1>;
+		qcom,pin-func = <0>;
+		label = "cityman_iris_reset_active";
+		cityman_iris_reset_active: cityman_iris_reset_active {
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+	cityman_iris_reset_sleep_grp {
+		qcom,pins = <&gp 102>;
+		qcom,num-grp-pins = <1>;
+		qcom,pin-func = <0>;
+		label = "cityman_iris_reset_sleep";
+		cityman_iris_reset_sleep: cityman_iris_reset_sleep {
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+	};
+};
diff --git a/drivers/media/platform/msm/camera_v2/Kconfig b/drivers/media/platform/msm/camera_v2/Kconfig
index 375e56d8..67870cf0 100644
--- a/drivers/media/platform/msm/camera_v2/Kconfig
+++ b/drivers/media/platform/msm/camera_v2/Kconfig
@@ -9,6 +9,14 @@ config MSM_CAMERA_SENSOR
           data for camera support. The driver support V4L2
           subdev APIs.
 
+config CITYMAN_IRIS_ID
+        bool "Lumia 950 XL opt-in iris sensor identification"
+        depends on MSM_CAMERA_SENSOR && MSM_CCI && OF && PINCTRL && REGULATOR
+        default n
+        help
+          Adds a board-specific, root-triggered sensor ID diagnostic. It has
+          no automatic power-up, streaming, illumination or biometric support.
+
 config MSM_CPP
         bool "Qualcomm MSM Camera Post Processing Engine support"
         depends on MSMB_CAMERA
diff --git a/drivers/media/platform/msm/camera_v2/sensor/Makefile b/drivers/media/platform/msm/camera_v2/sensor/Makefile
index 09afb7b6..066c325f 100644
--- a/drivers/media/platform/msm/camera_v2/sensor/Makefile
+++ b/drivers/media/platform/msm/camera_v2/sensor/Makefile
@@ -5,6 +5,7 @@ ccflags-y += -Idrivers/media/platform/msm/camera_v2/sensor/io
 ccflags-y += -Idrivers/media/platform/msm/camera_v2/sensor/cci
 obj-$(CONFIG_MSMB_CAMERA) += cci/ io/ csiphy/ csid/ actuator/ flash/ eeprom/ ois/
 obj-$(CONFIG_MSM_CAMERA_SENSOR) += msm_sensor_init.o msm_sensor_driver.o msm_sensor.o
+obj-$(CONFIG_CITYMAN_IRIS_ID) += cityman_iris_id.o
 obj-$(CONFIG_MT9M114) += mt9m114.o
 obj-$(CONFIG_OV5645) += ov5645.o
 obj-$(CONFIG_OV5645) += ov7695.o
