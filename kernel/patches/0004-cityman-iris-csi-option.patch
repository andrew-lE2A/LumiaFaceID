Subject: [PATCH] media: gate cityman PHY2 combo/CSID3 packet diagnostic
Base: patches 0001 through 0003 applied to cc84cab9900ee4e7a3046b3756858e9832caee72

Copy all five canonical driver files as documented in IRIS-CSI.md.
Normal reset waits and release return values stay unchanged; diagnostic resets
are bounded and diagnostic releases propagate clock/regulator failures.

diff --git a/drivers/media/platform/msm/camera_v2/Kconfig b/drivers/media/platform/msm/camera_v2/Kconfig
--- a/drivers/media/platform/msm/camera_v2/Kconfig
+++ b/drivers/media/platform/msm/camera_v2/Kconfig
@@ -1,3 +1,11 @@
+config CITYMAN_IRIS_CSI
+	bool "Lumia 950 XL bounded CSI packet diagnostic"
+	depends on CITYMAN_IRIS_STREAM && MSMB_CAMERA=y
+	default n
+	help
+	  Separate root-triggered PHY2 combo/CSID3 packet observation. Both
+	  receivers must be idle. No ISPIF, VFE, image DMA or illumination.
+
 config CITYMAN_IRIS_STREAM
 	bool "Lumia 950 XL bounded sensor stream diagnostic"
 	depends on CITYMAN_IRIS_ID && CRYPTO_SHA256
